USE_LOCAL_FALLBACK=true

# bge-small embedding service, hosted on Render (see /render-embedding-service)
# Comma-separated list of identical bge-small instances to shard across
EMBEDDING_URLS=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=bge-small-en-v1.5

# LLMs hosted on Modal (see /modal-llm-service)
MODAL_LLM_URL_GEMMA2=
MODAL_LLM_URL_LLAMA32_1B=
MODAL_LLM_URL_LLAMA32_3B=

# Modal secures Web Functions with a proxy token pair (not a bearer token).
# Create one at https://modal.com/settings/proxy-auth-tokens
# You'll get a Token ID (wk-...) and a Token Secret (ws-...).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

MAX_UPLOAD_MB=10
MAX_FILES=5

ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
